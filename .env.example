# Study Buddy Environment Variables
# Copy this file to .env and fill in your values
# 
# IMPORTANT: Never commit .env to version control!

#------------------------------------------------------------
# Required: LLM API Key
#------------------------------------------------------------
# Your API key for the LLM provider (Groq, OpenAI, etc.)
# Get your key from:
#   - Groq: https://console.groq.com/keys
#   - OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

#------------------------------------------------------------
# Optional: Override Config File Settings
#------------------------------------------------------------
# These override values in study_buddy.yaml

# Neo4j password (overrides config file)
# NEO4J_PASSWORD=neo4j2026

# Use a different config file
# STUDY_BUDDY_CONFIG=/path/to/custom_config.yaml

# Backend server port
# SERVER_PORT=8000